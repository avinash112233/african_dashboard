# MERRA2 PM2.5 station parquet backend
# Folder containing files named like:
# 2000_AfricanStationsFull.parquet, 2001_AfricanStationsFull.parquet, ...
MERRA2_PARQUET_DIR=path

# Legacy OPeNDAP settings (optional, kept for backward compatibility route)
# Create account: https://urs.earthdata.nasa.gov/

EARTHDATA_USERNAME=your_username
EARTHDATA_PASSWORD=your_password
# Optional alternative auth (if OAuth pre-authorization blocks basic auth):
EARTHDATA_TOKEN=your_earthdata_token

# FIRMS (Fire Hotspots) – get free key at https://firms.modaps.eosdis.nasa.gov/api/

VITE_FIRMS_MAP_KEY=your_firms_map_key

# Optional AAQE forecast GeoJSON base (same as aeronet_aq GEOJSON_AAQE). Defaults to /api/aeronet/... proxy.
# VITE_AAQE_FORECAST_BASE_URL=https://aeronet.gsfc.nasa.gov/data_push/AQI/output_AAQE_geoJSON/
# Or use direct NASA URL in the browser (CORS must allow your origin):
# VITE_AAQE_USE_DIRECT_NASA=true

# Optional: backend port (default 3001)
# MERRA2_API_PORT=3001

# Production: the Vite dev proxy does not run on static hosts. Run `npm run backend` and
# route /api/aeronet and /api/merra2 to that server (or equivalent nginx rewrite) so
# AERONET site lists and AAQE forecast GeoJSON load in the built app.